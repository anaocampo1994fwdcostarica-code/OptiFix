{
  "name": "OptiFix - Automatizaciones de correo, usuarios y chat",
  "nodes": [
    {
      "parameters": { "path": "optifix-order-delivered", "httpMethod": "POST", "responseMode": "responseNode" },
      "name": "Webhook · Cambio de estado", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [180, 160]
    },
    {
      "parameters": { "jsCode": "const d = $json.body ?? $json;\nreturn [{ json: { to: d.cliente?.email, subject: `OptiFix: actualización de orden #${d.numero || d.ordenId}`, html: `<div style='font-family:Arial;color:#172033'><h2>Hola ${d.cliente?.nombre || 'cliente'}</h2><p>Tu equipo está en estado: <b>${d.estado}</b>.</p><p>${d.comentarioTecnico || 'Tu orden fue actualizada.'}</p><p><a href='${d.seguimientoUrl}'>Ver estado y chatear con el asistente</a></p></div>` } }];" },
      "name": "Preparar correo HTML", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 160]
    },
    {
      "parameters": { "fromEmail": "={{ $env.OPTIFIX_FROM_EMAIL }}", "toEmail": "={{ $json.to }}", "subject": "={{ $json.subject }}", "html": "={{ $json.html }}" },
      "name": "SMTP · Enviar boleta", "type": "n8n-nodes-base.emailSend", "typeVersion": 2, "position": [700, 160],
      "credentials": { "smtp": { "id": "CONFIGURAR_SMTP", "name": "Configurar SMTP" } }
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true, message: 'Correo de actualización enviado' } }}" },
      "name": "Responder cambio de estado", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [960, 160]
    },
    {
      "parameters": { "path": "optifix-users", "httpMethod": "POST", "responseMode": "responseNode" },
      "name": "Webhook · Registro de usuario", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [180, 390]
    },
    {
      "parameters": { "jsCode": "const d = $json.body ?? $json;\nif (d.action !== 'USER_CREATE' || !d.usuario?.usuario) throw new Error('Payload de usuario inválido');\nreturn [{ json: { ok: true, data: { usuario: d.usuario.usuario, rol: d.usuario.rol }, message: 'Evento de usuario registrado para notificación' } }];" },
      "name": "Validar registro de usuario", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [460, 390]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "name": "Responder registro de usuario", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [720, 390]
    },
    {
      "parameters": { "path": "optifix-chat", "httpMethod": "POST", "responseMode": "responseNode" },
      "name": "Webhook · Chat público", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [180, 620]
    },
    {
      "parameters": { "jsCode": "const d = $json.body ?? $json;\n// Para producción, sustituir este fallback por HTTP Request a JSON Server o API segura.\nconst db = $getWorkflowStaticData('global').optifixMock || {};\nconst orden = (db.ordenes || []).find(o => String(o.id) === String(d.ordenId) || String(o.numero) === String(d.ordenId)) || {};\nreturn [{ json: { pregunta: d.pregunta, ordenId: d.ordenId, contexto: { estado: orden.estado_actual || 'No disponible', comentario: orden.diagnostico || orden.trabajo_solicitado || 'Sin comentario técnico' } }];" },
      "name": "Consultar contexto de orden", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [440, 620]
    },
    {
      "parameters": { "jsCode": "const d = $json;\nreturn [{ json: { ok: true, respuesta: `La orden está en estado ${d.contexto.estado}. ${d.contexto.comentario}. Para una fecha exacta, confirma directamente con el taller.` } }];" },
      "name": "Agente IA · Fallback seguro", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [700, 620]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "name": "Responder chat", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [960, 620]
    },
    {
      "parameters": { "path": "optifix-admin-chat", "httpMethod": "POST", "responseMode": "responseNode" },
      "name": "Webhook OptiBot administrativo", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [180, 870]
    },
    {
      "parameters": { "jsCode": "const d = $json.body ?? $json;\nconst pregunta = String(d.pregunta || '').trim();\nif (!pregunta) throw new Error('La pregunta es obligatoria');\nconst u = d.usuario || {};\nreturn [{ json: { pregunta, usuario: { id: u.id, nombre: u.nombre, usuario: u.usuario, email: u.email, rol: u.rol } } }];" },
      "name": "Validar consulta OptiBot", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [420, 870]
    },
    {
      "parameters": { "promptType": "define", "text": "={{ $json.pregunta }}", "options": { "systemMessage": "Eres OptiBot, asistente administrativo de OptiFix. Responde con claridad, brevedad y tono profesional. Fundamenta tus respuestas exclusivamente en los datos que obtengas desde las herramientas conectadas a este agente: órdenes, clientes, equipos, servicios y usuarios. No inventes datos, fechas ni contactos. Si no hay evidencia suficiente, indícalo y sugiere verificarlo en el sistema. El usuario autenticado es: {{ JSON.stringify($json.usuario) }}." } },
      "name": "AI Agent OptiBot", "type": "@n8n/n8n-nodes-langchain.agent", "typeVersion": 2, "position": [700, 870]
    },
    {
      "parameters": { "model": "deepseek-chat", "options": {} },
      "name": "Modelo DeepSeek Configurar", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "typeVersion": 1, "position": [620, 1040],
      "credentials": { "openAiApi": { "id": "CONFIGURAR_DEEPSEEK", "name": "Configurar credencial DeepSeek" } }
    },
    {
      "parameters": { "jsCode": "const respuesta = String($json.output || $json.text || '').trim();\nif (!respuesta) throw new Error('El agente no devolvió una respuesta');\nreturn [{ json: { success: true, respuesta } }];" },
      "name": "Formatear respuesta OptiBot", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [960, 870]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}" },
      "name": "Responder OptiBot", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1, "position": [1200, 870]
    },
    {
      "parameters": { "toolDescription": "Consulta las órdenes de reparación. Úsala para estados, números, diagnósticos, importes o fechas.", "method": "GET", "url": "http://host.docker.internal:3001/ordenes" },
      "name": "Datos · Órdenes (solo lectura)", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1, "position": [520, 1170]
    },
    {
      "parameters": { "toolDescription": "Consulta clientes del taller. Úsala únicamente para datos de contacto o identificación necesarios.", "method": "GET", "url": "http://host.docker.internal:3001/clientes" },
      "name": "Datos · Clientes (solo lectura)", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1, "position": [720, 1170]
    },
    {
      "parameters": { "toolDescription": "Consulta equipos registrados y su información técnica.", "method": "GET", "url": "http://host.docker.internal:3001/equipos" },
      "name": "Datos · Equipos (solo lectura)", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1, "position": [920, 1170]
    },
    {
      "parameters": { "toolDescription": "Consulta el catálogo de servicios y precios de referencia del taller.", "method": "GET", "url": "http://host.docker.internal:3001/servicios" },
      "name": "Datos · Servicios (solo lectura)", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1, "position": [1120, 1170]
    },
    {
      "parameters": { "toolDescription": "Consulta colaboradores y técnicos registrados. La fuente no contiene contraseñas; úsala para nombre, correo, teléfono o rol.", "method": "GET", "url": "http://host.docker.internal:3001/usuarios-publicos" },
      "name": "Datos · Usuarios (solo lectura)", "type": "@n8n/n8n-nodes-langchain.toolHttpRequest", "typeVersion": 1, "position": [1320, 1170]
    }
  ],
